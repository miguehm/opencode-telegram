{
  "name": "opencode-telegram",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Telegram bot that drives the opencode harness and try workspaces",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "sh scripts/biome.sh check src tests scripts",
    "lint:fix": "sh scripts/biome.sh check --write src tests scripts",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node --env-file-if-exists=.env --import tsx scripts/smoke.ts"
  },
  "dependencies": {
    "@grammyjs/auto-retry": "^2.0.2",
    "@opencode-ai/sdk": "^1.19.5",
    "grammy": "^1.46.0",
    "strip-ansi": "^7.2.0",
    "ws": "^8.22.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@types/node": "^22.16.0",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.1.0"
  }
}
